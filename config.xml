<?xml version='1.0' encoding='utf-8'?>
<widget id="com.xcoder.app"
        version="1.1.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>XCoder</name>
    <description>
        XCoder — a mobile-first code editor and IDE for Android.
        CodeMirror 6 powered, plugin extensible, with integrated terminal and LSP support.
    </description>
    <author email="dev@xcoder.app" href="https://github.com/xcoder-app/xcoder">
        XCoder Contributors
    </author>

    <content src="index.html" />
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <preference name="BackgroundColor" value="0xff0d1117" />
    <preference name="Orientation" value="all" />
    <preference name="Fullscreen" value="false" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="ShowSplashScreenSpinner" value="false" />
    <preference name="AndroidWindowSplashScreenBackground" value="#0d1117" />
    <preference name="AndroidXEnabled" value="true" />

    <!-- Filesystem access (sdcard, app-private storage) -->
    <plugin name="cordova-plugin-file" spec="^8.0.0" />
    <!-- Runtime permission prompts (READ/WRITE_EXTERNAL_STORAGE) -->
    <plugin name="cordova-plugin-android-permissions" spec="^1.1.5" />
    <!-- Safe-area / viewport handling on notch devices -->
    <plugin name="cordova-plugin-fullscreen" spec="^2.0.0" />

    <platform name="android">
        <preference name="AndroidMinimumSdkVersion" value="24" />
        <preference name="AndroidTargetSdkVersion" value="34" />
        <preference name="android-minSdkVersion" value="24" />
        <allow-intent href="market:*" />
        <icon src="res/icon.png" />
        <splash src="res/splash.png" />
    </platform>
</widget>
