<?xml version='1.0' encoding='utf-8'?>
<widget id="app.xcoder.editor" version="1.1.0" xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>XCoder</name>
    <description>
        XCoder — a mobile-first code editor &amp; IDE for the web and Android.
        Built on CodeMirror 6. Community fork of Acode.
    </description>
    <author email="carsaimz@users.noreply.github.com" href="https://github.com/carsaimz">
        carsaimz &amp; XCoder contributors
    </author>

    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />

    <preference name="Fullscreen" value="false" />
    <preference name="Orientation" value="default" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="BackgroundColor" value="#1e1e2e" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/icon.png" />

    <platform name="android">
        <preference name="AndroidPackageName" value="app.xcoder.editor" />
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <allow-intent href="market:*" />
        <icon src="res/icon.png" />
    </platform>

    <engine name="android" spec="^13.0.0" />
</widget>
