<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" xmlns:android="http://schemas.android.com/apk/res/android" id="com.carsaimz.xcoder.rk.plugin.plugincontext" version="1.0.0">
    <name>PluginContext</name>


    <platform name="android">
        <config-file parent="/*" target="res/xml/config.xml">
            <feature name="Tee">
                <param name="android-package" value="com.carsaimz.xcoder.rk.plugin.Tee" />
            </feature>
        </config-file>

        <source-file src="src/android/Tee.java" target-dir="src/com/carsaimz/xcoder/rk/plugin" />
        <source-file src="src/android/com/carsaimz/xcoder/rk/plugin/EncryptedPreferenceManager.java" target-dir="src/com/carsaimz/xcoder/rk/plugin" />

        <framework src="androidx.security:security-crypto:1.1.0" />
    </platform>
</plugin>