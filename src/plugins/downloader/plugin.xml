<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" xmlns:android="http://schemas.android.com/apk/res/android" id="com.carsaimz.xcoder.downloader" version="1.0.0">
    <name>Downloader</name>
    <description>System DownloadManager bridge — background downloads with the native Android progress notification (app updates, APKs).</description>

    <js-module name="Downloader" src="www/downloader.js">
        <clobbers target="window.Downloader" />
    </js-module>

    <platform name="android">
        <config-file parent="/*" target="res/xml/config.xml">
            <feature name="Downloader">
                <param name="android-package" value="com.carsaimz.xcoder.downloader.Downloader" />
            </feature>
        </config-file>
        <source-file src="src/android/Downloader.java" target-dir="src/com/carsaimz/xcoder/downloader" />
    </platform>
</plugin>
